<Window x:Class="PingCandidateFinder.WinUI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="未占用IP查找">
  <Grid x:Name="Root">
    <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <ScrollViewer x:Name="PageScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
      <StackPanel MaxWidth="1240" Margin="32,24" Spacing="16">
        <StackPanel Spacing="3" Margin="0,0,0,4">
          <TextBlock Text="未占用IP查找" FontSize="24" FontWeight="SemiBold"/>
          <TextBlock Text="输入网段，获取待确认的 IPv4 地址" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
        </StackPanel>
        <Grid x:Name="Panels" ColumnSpacing="16" RowSpacing="16">
          <Grid.ColumnDefinitions><ColumnDefinition Width="45*"/><ColumnDefinition Width="55*"/></Grid.ColumnDefinitions>
          <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
          <Border x:Name="FormCard" Grid.Row="0" Grid.Column="0" Padding="24" CornerRadius="8" BorderThickness="1"
                  Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                  BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
            <StackPanel Spacing="12">
              <StackPanel Spacing="3">
                <TextBlock Text="扫描设置" FontSize="18" FontWeight="SemiBold"/>
                <TextBlock x:Name="ScanSettingsSubtitle" Text="找到指定数量后自动停止" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
              </StackPanel>
              <StackPanel Spacing="6">
                <TextBlock Text="扫描模式"/>
                <ComboBox x:Name="ScanModeInput" SelectedIndex="0" MinWidth="200">
                  <ComboBoxItem Content="按数量查找"/>
                  <ComboBoxItem Content="全量扫描"/>
                </ComboBox>
              </StackPanel>
              <Grid ColumnSpacing="12" RowSpacing="12">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <StackPanel Grid.Row="0" Grid.Column="0" Spacing="6">
                  <TextBlock Text="网段 IP"/><TextBox x:Name="NetworkInput" PlaceholderText="192.168.10.0"/>
                </StackPanel>
                <StackPanel Grid.Row="0" Grid.Column="1" Spacing="6">
                  <TextBlock Text="子网掩码"/><TextBox x:Name="MaskInput" Text="255.255.255.0" PlaceholderText="23 或 255.255.254.0"/>
                </StackPanel>
                <StackPanel Grid.Row="1" Grid.Column="0" Spacing="6">
                  <TextBlock Text="候选数量"/><TextBox x:Name="CountInput" Text="5" PlaceholderText="1–1000"/>
                </StackPanel>
                <StackPanel Grid.Row="1" Grid.Column="1" Spacing="6">
                  <TextBlock Text="网关（可选）"/><TextBox x:Name="GatewayInput" PlaceholderText="网关未回应时提示"/>
                </StackPanel>
                <StackPanel Grid.Row="2" Grid.Column="0" Spacing="6">
                  <TextBlock Text="起始 IP（可选）"/><TextBox x:Name="StartInput" PlaceholderText="留空则从开头扫描"/>
                </StackPanel>
              </Grid>
              <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,4,0,0">
                <Button x:Name="StartButton" Content="开始查找" Style="{StaticResource AccentButtonStyle}" Click="StartClicked"/>
                <Button x:Name="StopButton" Content="停止" IsEnabled="False" Click="StopClicked"/>
              </StackPanel>
              <TextBlock Text="/16–/30  ·  自动跳过网段、广播地址和网关"
                         Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
            </StackPanel>
          </Border>
          <Border x:Name="ResultsCard" Grid.Row="0" Grid.Column="1" Padding="24" CornerRadius="8" BorderThickness="1"
                  Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                  BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
            <StackPanel Spacing="12">
              <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel Spacing="3">
                  <TextBlock x:Name="ResultsTitle" Text="待确认 IP" FontSize="18" FontWeight="SemiBold"/>
                  <TextBlock x:Name="ResultsSubtitle" Text="连续两次 ping 未回应，仍需确认" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                </StackPanel>
                <TextBlock x:Name="CandidateCount" Grid.Column="1" Text="0 / 5"
                           Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"/>
              </Grid>
              <ComboBox x:Name="ResultViewInput" SelectedIndex="0" MinWidth="220" Visibility="Collapsed">
                <ComboBoxItem Content="疑似空闲（待确认）"/>
                <ComboBoxItem Content="已回应"/>
                <ComboBoxItem Content="无法判断"/>
              </ComboBox>
              <ProgressBar x:Name="ScanProgressBar" Height="4" Minimum="0" Maximum="1" Value="0"/>
              <Grid Height="184">
                <ListView x:Name="CandidateList" SelectionMode="Single"
                          SelectionChanged="CandidateSelectionChanged" DoubleTapped="CandidateDoubleTapped">
                  <ListView.ItemTemplate>
                    <DataTemplate>
                      <Grid MinHeight="34" Padding="8,4">
                        <TextBlock Text="{Binding}" VerticalAlignment="Center" FontWeight="SemiBold"/>
                      </Grid>
                    </DataTemplate>
                  </ListView.ItemTemplate>
                </ListView>
                <TextBlock x:Name="EmptyText" Text="扫描后，候选地址会显示在这里。"
                           HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
              </Grid>
              <TextBlock x:Name="ListLimitText" Text="只展示前 1000 个；复制全部可获取当前分类的所有地址。"
                         Visibility="Collapsed" TextWrapping="Wrap"
                         Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
              <StackPanel Orientation="Horizontal" Spacing="8">
                <Button x:Name="CopySelectedButton" Content="复制选中" IsEnabled="False" Click="CopySelectedClicked"/>
                <Button x:Name="CopyAllButton" Content="复制全部" IsEnabled="False" Click="CopyAllClicked"/>
              </StackPanel>
              <Grid ColumnSpacing="16">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <StackPanel Grid.Column="0" Spacing="3">
                  <TextBlock Text="已检查 / 可扫描" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                  <TextBlock x:Name="CheckedText" Text="0" FontSize="20" FontWeight="SemiBold"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Spacing="3">
                  <TextBlock Text="已回应" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                  <TextBlock x:Name="RepliedText" Text="0" FontSize="20" FontWeight="SemiBold"/>
                </StackPanel>
                <StackPanel Grid.Column="2" Spacing="3">
                  <TextBlock Text="疑似空闲（待确认）" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                  <TextBlock x:Name="UnansweredText" Text="0" FontSize="20" FontWeight="SemiBold"/>
                </StackPanel>
                <StackPanel Grid.Row="1" Grid.Column="0" Spacing="3" Margin="0,10,0,0">
                  <TextBlock Text="无法判断" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                  <TextBlock x:Name="UnknownText" Text="0" FontSize="20" FontWeight="SemiBold"/>
                </StackPanel>
                <StackPanel Grid.Row="1" Grid.Column="1" Spacing="3" Margin="0,10,0,0">
                  <TextBlock Text="耗时" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                  <TextBlock x:Name="ElapsedText" Text="0.0 秒" FontSize="20" FontWeight="SemiBold"/>
                </StackPanel>
              </Grid>
            </StackPanel>
          </Border>
        </Grid>
        <InfoBar IsOpen="True" Severity="Informational" IsClosable="False"
                 Message="未回应只代表待确认；分配前请按网络规则核对。"/>
      </StackPanel>
    </ScrollViewer>
    <Border Grid.Row="1" Padding="32,10" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
            BorderThickness="0,1,0,0" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
      <TextBlock x:Name="StatusText" Text="填写网段和候选数量后开始查找。" TextWrapping="Wrap"
                 Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
    </Border>
  </Grid>
</Window>
